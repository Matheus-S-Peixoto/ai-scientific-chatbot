{
  "name": "desmistifake-bot-backend",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2025-10-08",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.06,
      "persist": false,
      "invocation_logs": true,
      "destinations": ["honeycomb-logs"]
    },
    "traces": {
      "enabled": true,
      "persist": false,
      "head_sampling_rate": 0.05
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "desmistifake-index"
    }
  ]
}